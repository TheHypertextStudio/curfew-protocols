    private func hpkeSealVector(
        recipientPublicKey: Data,
        ephemeralPrivateKey: Data,
        encapsulatedKey: Data,
        info: Data,
        aad: Data,
        plaintext: Data
    ) throws -> HPKEVector {
        let kemSuite = Data("KEM".utf8) + i2osp(0x10, length: 2)
