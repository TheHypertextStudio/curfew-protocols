            pseudorandomKey: eaePRK,
            info: i2osp(32, length: 2) + Data("HPKE-v1".utf8) + kemSuite +
                Data("shared_secret".utf8) + encapsulatedKey + recipientPublicKey,
            length: 32
        )
        let pskIDHash = labeledExtract(
            suite: hpkeSuite,
            salt: Data(),
            label: "psk_id_hash",
            inputKeyMaterial: Data()
        )
        let infoHash = labeledExtract(
            suite: hpkeSuite,
            salt: Data(),
            label: "info_hash",
            inputKeyMaterial: info
        )
        let context = Data([0]) + pskIDHash + infoHash
        let secret = labeledExtract(
            suite: hpkeSuite,
            salt: sharedSecret,
            label: "secret",
            inputKeyMaterial: Data()
        )
        let key = labeledExpand(
            suite: hpkeSuite,
            pseudorandomKey: secret,
            label: "key",
            info: context,
            length: 32
        )
        let baseNonce = labeledExpand(
            suite: hpkeSuite,
            pseudorandomKey: secret,
            label: "base_nonce",
            info: context,
            length: 12
