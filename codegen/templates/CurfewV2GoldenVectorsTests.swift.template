private struct Draft07Subset {
    let root: [String: Any]

    func valid(_ instance: Any, schema: [String: Any]) -> Bool {
        if let reference = schema["$ref"] as? String,
           let resolved = resolve(reference)
        {
            return valid(instance, schema: resolved)
        }
        if let branches = schema["oneOf"] as? [[String: Any]],
           branches.filter({ valid(instance, schema: $0) }).count != 1
        {
            return false
        }
        if let constant = schema["const"], !jsonEqual(instance, constant) {
            return false
        }
        if let values = schema["enum"] as? [Any],
           !values.contains(where: { jsonEqual(instance, $0) })
        {
            return false
        }
        if let rawType = schema["type"] {
            let types: [String]
            if let type = rawType as? String {
                types = [type]
            } else {
                types = rawType as? [String] ?? []
            }
            if !types.contains(where: { matchesType(instance, type: $0) }) {
                return false
            }
        }

        if let object = instance as? [String: Any] {
            if let rule = schema["x-curfew-derived-campaign-duration"] as? [String: Any] {
                guard let attemptsProperty = rule["attemptsProperty"] as? String,
                      let ringProperty = rule["ringProperty"] as? String,
                      let quietProperty = rule["quietProperty"] as? String,
                      let durationProperty = rule["durationProperty"] as? String,
                      let attempts = (object[attemptsProperty] as? NSNumber)?.int64Value,
                      let ringing = (object[ringProperty] as? NSNumber)?.int64Value,
                      let quiet = (object[quietProperty] as? NSNumber)?.int64Value,
                      let declaredDuration = (object[durationProperty] as? NSNumber)?.int64Value,
                      let cap = (rule["capSeconds"] as? NSNumber)?.int64Value
                else { return false }
                let computed = attempts * ringing + max(0, attempts - 1) * quiet
                if computed != declaredDuration || computed > cap {
                    return false
                }
            }
            let required = schema["required"] as? [String] ?? []
            if required.contains(where: { object[$0] == nil }) {
                return false
            }
            if let properties = schema["properties"] as? [String: Any] {
                if (schema["additionalProperties"] as? Bool) == false,
                   object.keys.contains(where: { properties[$0] == nil })
                {
                    return false
                }
                for (name, rawProperty) in properties {
                    guard let value = object[name],
                          let property = rawProperty as? [String: Any]
                    else { continue }
                    if !valid(value, schema: property) {
                        return false
                    }
                }
            }
        }

        if let array = instance as? [Any] {
            if let minimum = schema["minItems"] as? Int, array.count < minimum {
                return false
            }
            if let maximum = schema["maxItems"] as? Int, array.count > maximum {
                return false
            }
            if (schema["uniqueItems"] as? Bool) == true {
                for index in array.indices {
                    if array[(index + 1)...].contains(where: { jsonEqual(array[index], $0) }) {
                        return false
                    }
                }
            }
            if let itemSchema = schema["items"] as? [String: Any],
               array.contains(where: { !valid($0, schema: itemSchema) })
            {
                return false
            }
        }

        if let string = instance as? String {
            if let minimum = schema["minLength"] as? Int, string.count < minimum {
                return false
            }
            if let maximum = schema["maxLength"] as? Int, string.count > maximum {
                return false
            }
            if let pattern = schema["pattern"] as? String,
               string.range(of: pattern, options: .regularExpression) == nil
            {
                return false
            }
            if schema["format"] as? String == "uri",
               URLComponents(string: string)?.scheme == nil
            {
                return false
            }
        }

        if let number = instance as? NSNumber, !isBoolean(number) {
            if let minimum = schema["minimum"] as? NSNumber,
               number.doubleValue < minimum.doubleValue
            {
                return false
            }
            if let maximum = schema["maximum"] as? NSNumber,
               number.doubleValue > maximum.doubleValue
            {
                return false
            }
        }
        return true
    }

    private func resolve(_ reference: String) -> [String: Any]? {
        guard reference.hasPrefix("#/") else { return nil }
        var node: Any = root
        for segment in reference.dropFirst(2).split(separator: "/") {
            let key = segment.replacingOccurrences(of: "~1", with: "/")
                .replacingOccurrences(of: "~0", with: "~")
            guard let next = (node as? [String: Any])?[key] else { return nil }
            node = next
        }
        return node as? [String: Any]
    }

    private func matchesType(_ value: Any, type: String) -> Bool {
        switch type {
        case "null": return value is NSNull
        case "object": return value is [String: Any]
        case "array": return value is [Any]
        case "string": return value is String
        case "boolean": return (value as? NSNumber).map(isBoolean) == true
        case "integer":
            guard let number = value as? NSNumber, !isBoolean(number) else { return false }
            return number.doubleValue.rounded(.towardZero) == number.doubleValue
        case "number": return value is NSNumber && !isBoolean(value as! NSNumber)
        default: return true
        }
    }

    private func isBoolean(_ number: NSNumber) -> Bool {
        CFGetTypeID(number) == CFBooleanGetTypeID()
    }

    private func jsonEqual(_ lhs: Any, _ rhs: Any) -> Bool {
        (lhs as AnyObject).isEqual(rhs)
    }
}
