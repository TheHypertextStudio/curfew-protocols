{
  "name": "@hypertext/curfew-protocols",
  "version": "1.1.0",
  "description": "Versioned, platform-neutral wire contract for Curfew local MCP, remote MCP, device enrollment, and signed lock commands.",
  "type": "module",
  "main": "./generated/typescript/index.js",
  "types": "./generated/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/typescript/index.d.ts",
      "import": "./generated/typescript/index.js"
    },
    "./schemas/*": "./schemas/*.json"
  },
  "files": [
    "schemas",
    "generated/typescript",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "codegen": "tsx codegen/typescript.ts && tsx codegen/swift.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit --skipLibCheck false tests/consumer-smoke.ts",
    "prepublishOnly": "pnpm codegen && pnpm typecheck && pnpm typecheck:consumer && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "quicktype-core": "^23.0.171",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheHypertextStudio/curfew-protocols.git"
  },
  "license": "MIT",
  "keywords": [
    "curfew",
    "mcp",
    "protocols",
    "schemas"
  ]
}
