{
  "name": "@thehypertextstudio/curfew-protocols",
  "version": "0.3.0",
  "description": "Versioned cross-platform Curfew contract for schedules, wake campaigns, E2EE sync, accounts, callbacks, devices, and MCP.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "./generated/typescript/index.js",
  "types": "./generated/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/typescript/index.d.ts",
      "import": "./generated/typescript/index.js"
    },
    "./validation": {
      "types": "./generated/typescript/validation.d.ts",
      "import": "./generated/typescript/validation.js"
    },
    "./schemas/*": "./schemas/*.json"
  },
  "files": [
    "schemas",
    "generated/typescript",
    "generated/kotlin/build.gradle.kts",
    "generated/kotlin/src/main",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "codegen": "tsx codegen/typescript.ts && tsx codegen/swift.ts && tsx codegen/kotlin.ts && tsx codegen/golden-tests.ts",
    "test": "vitest run",
    "test:kotlin": "./gradlew :generated:kotlin:test",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit --skipLibCheck false tests/consumer-smoke.ts",
    "prepublishOnly": "pnpm codegen && pnpm typecheck && pnpm typecheck:consumer && pnpm test && swift test && pnpm test:kotlin"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "quicktype-core": "^23.0.171",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheHypertextStudio/curfew-protocols.git"
  },
  "license": "MIT",
  "keywords": [
    "curfew",
    "mcp",
    "protocols",
    "schemas",
    "android",
    "e2ee",
    "alarm"
  ]
}
