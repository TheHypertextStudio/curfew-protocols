{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://curfew-protocols.hypertext.studio/schemas/alarm.json",
  "title": "CurfewAlarmContract",
  "description": "Perpetual Alarm recurrence, selected devices, persisted campaign attempts, deterministic deadlines, and terminal wake outcomes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "alarm": { "$ref": "#/definitions/AlarmDefinition" },
    "campaign": { "$ref": "#/definitions/WakeCampaign" },
    "attempt": { "$ref": "#/definitions/WakeAttempt" },
    "outcome": { "$ref": "#/definitions/WakeOutcome" }
  },
  "definitions": {
    "CanonicalUUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "UTCInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "IANATimeZone": {
      "type": "string",
      "pattern": "^[A-Za-z_+-]+(?:/[A-Za-z0-9_+-]+)+$",
      "description": "Explicit IANA timezone identifier. Fixed-offset abbreviations are not accepted."
    },
    "DSTResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap", "overlap"],
      "properties": {
        "gap": {
          "type": "string",
          "const": "first_valid_instant",
          "description": "A nonexistent local time advances to the first valid instant after the DST gap."
        },
        "overlap": {
          "type": "string",
          "const": "first_occurrence",
          "description": "An ambiguous repeated local time resolves to its first occurrence."
        }
      }
    },
    "AlarmConfiguration": {
      "description": "campaignDurationSeconds is derived, never independently configured: it must equal maximumAttempts * ringDurationSeconds + (maximumAttempts - 1) * quietIntervalSeconds and must not exceed 7200 seconds. Defaults produce three two-minute attempts and two five-minute quiet intervals: 960 seconds total.",
      "type": "object",
      "x-curfew-derived-campaign-duration": {
        "attemptsProperty": "maximumAttempts",
        "ringProperty": "ringDurationSeconds",
        "quietProperty": "quietIntervalSeconds",
        "durationProperty": "campaignDurationSeconds",
        "capSeconds": 7200
      },
      "additionalProperties": false,
      "required": ["maximumAttempts", "ringDurationSeconds", "quietIntervalSeconds", "campaignDurationSeconds", "selectedDeviceIds"],
      "properties": {
        "maximumAttempts": { "type": "integer", "minimum": 1, "maximum": 24, "default": 3 },
        "ringDurationSeconds": { "type": "integer", "minimum": 30, "maximum": 7200, "default": 120 },
        "quietIntervalSeconds": { "type": "integer", "minimum": 0, "maximum": 7200, "default": 300 },
        "campaignDurationSeconds": { "type": "integer", "minimum": 30, "maximum": 7200, "default": 960, "readOnly": true },
        "selectedDeviceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/CanonicalUUID" },
          "description": "Android alarm devices selected for this alarm; clients default to the primary alarm phone."
        }
      }
    },
    "WeeklyAlarmRecurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "timeZone", "localTime", "weekdays", "dstResolution"],
      "properties": {
        "kind": { "type": "string", "const": "weekly" },
        "timeZone": { "$ref": "#/definitions/IANATimeZone" },
        "localTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] }
        },
        "dstResolution": { "$ref": "#/definitions/DSTResolution" }
      }
    },
    "OneTimeAlarmRecurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scheduledAt", "timeZone"],
      "properties": {
        "kind": { "type": "string", "const": "one_time" },
        "scheduledAt": { "$ref": "#/definitions/UTCInstant" },
        "timeZone": { "$ref": "#/definitions/IANATimeZone" }
      }
    },
    "AlarmRecurrence": {
      "oneOf": [
        { "$ref": "#/definitions/WeeklyAlarmRecurrence" },
        { "$ref": "#/definitions/OneTimeAlarmRecurrence" }
      ]
    },
    "AlarmDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alarmId", "displayLabel", "enabled", "recurrence", "configuration"],
      "properties": {
        "alarmId": { "$ref": "#/definitions/CanonicalUUID" },
        "displayLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "enabled": { "type": "boolean" },
        "recurrence": { "$ref": "#/definitions/AlarmRecurrence" },
        "configuration": { "$ref": "#/definitions/AlarmConfiguration" },
        "callbackId": { "oneOf": [{ "$ref": "#/definitions/CanonicalUUID" }, { "type": "null" }] }
      }
    },
    "WakeCampaignState": {
      "type": "string",
      "enum": ["scheduled", "ringing_attempt", "quiet_interval", "satisfied", "exhausted", "overridden"]
    },
    "WakeCampaign": {
      "description": "Persisted campaign state. finalDeadlineAt must equal scheduledAt plus the validated AlarmConfiguration campaignDurationSeconds. Every device therefore derives one deadline, and an offline Mac releases at that instant without coordinator contact.",
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "alarmId", "timeZone", "scheduledAt", "finalDeadlineAt", "state", "attemptNumber", "selectedDeviceIds", "recordVersion", "writerCounter"],
      "properties": {
        "campaignId": { "$ref": "#/definitions/CanonicalUUID" },
        "alarmId": { "$ref": "#/definitions/CanonicalUUID" },
        "timeZone": { "$ref": "#/definitions/IANATimeZone" },
        "scheduledAt": { "$ref": "#/definitions/UTCInstant" },
        "startedAt": { "oneOf": [{ "$ref": "#/definitions/UTCInstant" }, { "type": "null" }] },
        "finalDeadlineAt": { "$ref": "#/definitions/UTCInstant" },
        "state": { "$ref": "#/definitions/WakeCampaignState" },
        "attemptNumber": { "type": "integer", "minimum": 0, "maximum": 24 },
        "selectedDeviceIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/CanonicalUUID" } },
        "recordVersion": { "type": "integer", "minimum": 1 },
        "writerCounter": { "type": "integer", "minimum": 1 }
      }
    },
    "WakeAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "attemptNumber", "state", "startedAt", "ringEndsAt"],
      "properties": {
        "campaignId": { "$ref": "#/definitions/CanonicalUUID" },
        "attemptNumber": { "type": "integer", "minimum": 1, "maximum": 24 },
        "state": { "type": "string", "enum": ["ringing", "quiet", "satisfied", "failed"] },
        "startedAt": { "$ref": "#/definitions/UTCInstant" },
        "ringEndsAt": { "$ref": "#/definitions/UTCInstant" },
        "quietEndsAt": { "oneOf": [{ "$ref": "#/definitions/UTCInstant" }, { "type": "null" }] },
        "completedAt": { "oneOf": [{ "$ref": "#/definitions/UTCInstant" }, { "type": "null" }] }
      }
    },
    "WakeOutcome": {
      "description": "Every terminal outcome releases the morning gate. Exhaustion records a factual missed wake-up; it never strands a device.",
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "result", "releasedAt"],
      "properties": {
        "campaignId": { "$ref": "#/definitions/CanonicalUUID" },
        "result": { "type": "string", "enum": ["satisfied", "exhausted", "remote_override"] },
        "releasedAt": { "$ref": "#/definitions/UTCInstant" },
        "satisfyingDeviceId": { "oneOf": [{ "$ref": "#/definitions/CanonicalUUID" }, { "type": "null" }] },
        "attemptsCompleted": { "type": "integer", "minimum": 0, "maximum": 24 }
      }
    }
  }
}
