{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hypertext.studio/curfew/device.json",
  "title": "DeviceContract",
  "description": "Platform-neutral device identity, eligibility, and normalized Curfew enforcement status.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "descriptor": { "$ref": "#/definitions/DeviceDescriptor" },
    "status": { "$ref": "#/definitions/DeviceStatusSnapshot" }
  },
  "definitions": {
    "DeviceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "displayName",
        "platform",
        "appVersion",
        "capabilities",
        "remoteLockEligible",
        "allDevicesEligible"
      ],
      "properties": {
        "deviceId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Open string. Unknown platforms must be retained."
        },
        "appVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Open string. Behavior is capability-gated rather than platform-gated."
          }
        },
        "remoteLockEligible": { "type": "boolean" },
        "allDevicesEligible": { "type": "boolean" },
        "revokedAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$" }
      }
    },
    "DevicePhase": {
      "type": "string",
      "enum": ["working", "warning", "locked", "day_off", "unknown"]
    },
    "DevicePresenceState": {
      "type": "string",
      "enum": ["present", "away", "unknown"],
      "description": "Whether the human is at the desk. 'unknown' means the device evaluated presence and could not decide; an absent presence object means the publisher does not report presence at all."
    },
    "DevicePresence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fused desk-presence verdict. The device fuses camera person-detection with HID idle locally and publishes only this verdict; raw sensor signals never cross the wire.",
      "required": ["state", "observedAt"],
      "properties": {
        "state": { "$ref": "#/definitions/DevicePresenceState" },
        "observedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
          "description": "When the fusion was computed. Carried separately from the enclosing snapshot because presence can be staler than the enforcement phase."
        }
      }
    },
    "DeviceStatusSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "phase",
        "timeZone",
        "scheduleDigest",
        "statusVersion",
        "observedAt"
      ],
      "properties": {
        "deviceId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "phase": { "$ref": "#/definitions/DevicePhase" },
        "timeZone": {
          "type": "string",
          "pattern": "^[A-Za-z_+-]+(?:/[A-Za-z0-9_+-]+)+$",
          "description": "IANA timezone identifier, for example America/Los_Angeles."
        },
        "scheduleDigest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Unpadded base64url digest of the local schedule version."
        },
        "statusVersion": { "type": "integer", "minimum": 0 },
        "observedAt": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$" },
        "presence": { "$ref": "#/definitions/DevicePresence" },
        "nextTransitionAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$" },
        "activeLockoutEndsAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$" }
      }
    }
  }
}
