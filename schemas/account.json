{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://curfew-protocols.hypertext.studio/schemas/account.json",
  "title": "CurfewAccountContract",
  "description": "Minimal server-readable Curfew account metadata: device public-key enrollment and revocation, routing status, entitlements, bounded remote overrides, and append-only audit records. Device names and decrypted settings are intentionally absent and belong in E2EE account settings.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enrollment": { "$ref": "#/definitions/AccountDeviceEnrollment" },
    "revocation": { "$ref": "#/definitions/DeviceRevocation" },
    "deviceStatus": { "$ref": "#/definitions/DeviceStatus" },
    "wakeStatus": { "$ref": "#/definitions/WakeStatus" },
    "entitlement": { "$ref": "#/definitions/Entitlement" },
    "directUnlockAuthorization": { "$ref": "#/definitions/DirectUnlockAuthorization" },
    "overrideRequest": { "$ref": "#/definitions/RemoteOverrideRequest" },
    "override": { "$ref": "#/definitions/RemoteOverride" },
    "audit": { "$ref": "#/definitions/AuditRecord" }
  },
  "definitions": {
    "CanonicalUUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "UTCInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "Base64URLSHA256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "AccountPublicKeyJWK": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x", "y"],
      "properties": {
        "kty": { "type": "string", "const": "EC" },
        "crv": { "type": "string", "const": "P-256" },
        "x": { "$ref": "#/definitions/Base64URLSHA256" },
        "y": { "$ref": "#/definitions/Base64URLSHA256" }
      }
    },
    "AccountDeviceEnrollment": {
      "description": "Minimal enrollment metadata for an E2EE-capable device. The coordinator receives only public keys, protocol capability, and epoch/timing metadata here. Device names and presentation metadata stay encrypted. The sole RootKeyEnvelope definition lives in e2ee.json and is uploaded separately for this deviceId.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "encryptionPublicKeyJwk", "signingPublicKeyJwk", "keyEpoch", "enrolledAt", "protocolVersion"],
      "properties": {
        "deviceId": { "$ref": "#/definitions/CanonicalUUID" },
        "encryptionPublicKeyJwk": { "$ref": "#/definitions/AccountPublicKeyJWK" },
        "signingPublicKeyJwk": { "$ref": "#/definitions/AccountPublicKeyJWK" },
        "keyEpoch": { "type": "integer", "minimum": 1 },
        "enrolledAt": { "$ref": "#/definitions/UTCInstant" },
        "protocolVersion": { "type": "string", "pattern": "^0\\.[0-9]+$", "description": "The highest Curfew protocol minor version implemented by this native device." }
      }
    },
    "DeviceRevocation": {
      "description": "Revoking a device requires account key-epoch rotation before later records are synchronized.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "revokedAt", "newKeyEpoch", "reason"],
      "properties": {
        "deviceId": { "$ref": "#/definitions/CanonicalUUID" },
        "revokedAt": { "$ref": "#/definitions/UTCInstant" },
        "newKeyEpoch": { "type": "integer", "minimum": 2 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "Entitlement": {
      "description": "Account-optional lifetime or subscription entitlement metadata. Signed offline license envelopes remain independently usable and claimable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entitlementId", "kind", "status", "productId", "provenance", "issuedAt"],
      "properties": {
        "entitlementId": { "$ref": "#/definitions/CanonicalUUID" },
        "kind": { "type": "string", "enum": ["lifetime", "subscription"] },
        "status": { "type": "string", "enum": ["active", "grace_period", "cancelled", "expired", "refunded", "revoked"] },
        "productId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "provenance": { "type": "string", "enum": ["signed_in_checkout", "guest_checkout", "signed_license_claim", "verified_checkout_claim", "legacy_email_match"] },
        "issuedAt": { "$ref": "#/definitions/UTCInstant" },
        "validUntil": { "oneOf": [{ "$ref": "#/definitions/UTCInstant" }, { "type": "null" }] },
        "claimedAt": { "oneOf": [{ "$ref": "#/definitions/UTCInstant" }, { "type": "null" }] }
      }
    },
    "DeviceStatus": {
      "description": "Minimal routing and release state for a device. Human-readable device presentation stays in encrypted account settings.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "connectivity", "wakeGate", "statusVersion", "observedAt"],
      "properties": {
        "deviceId": { "$ref": "#/definitions/CanonicalUUID" },
        "connectivity": { "type": "string", "enum": ["online", "offline"] },
        "wakeGate": { "type": "string", "enum": ["not_configured", "locked", "released"] },
        "activeCampaignId": { "oneOf": [{ "$ref": "#/definitions/CanonicalUUID" }, { "type": "null" }] },
        "statusVersion": { "type": "integer", "minimum": 1 },
        "observedAt": { "$ref": "#/definitions/UTCInstant" }
      }
    },
    "WakeStatus": {
      "description": "Minimal server-readable campaign state for routing, convergence, and the get_wake_status control surface. Callback definitions and alarm settings remain encrypted. Elapsed time never releases a wake gate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "state", "attemptNumber", "selectedDeviceIds", "statusVersion", "updatedAt"],
      "properties": {
        "campaignId": { "$ref": "#/definitions/CanonicalUUID" },
        "state": { "type": "string", "enum": ["scheduled", "ringing_attempt", "quiet_interval", "satisfied", "overridden"] },
        "attemptNumber": { "type": "integer", "minimum": 0 },
        "selectedDeviceIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/CanonicalUUID" } },
        "statusVersion": { "type": "integer", "minimum": 1 },
        "updatedAt": { "$ref": "#/definitions/UTCInstant" }
      }
    },
    "DirectUnlockAuthorization": {
      "description": "Explicit per-OAuth-client authorization for direct unlock. It is restricted to named devices, at most 60 minutes per override, and at most 30 days of validity; revocation is immediate. The validity deadline is derived exclusively as grantedAt plus validitySeconds, so no competing expiry field exists.",
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationId", "oauthClientId", "targetDeviceIds", "maximumOverrideMinutes", "validitySeconds", "grantedAt", "status"],
      "properties": {
        "authorizationId": { "$ref": "#/definitions/CanonicalUUID" },
        "oauthClientId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "targetDeviceIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/CanonicalUUID" } },
        "maximumOverrideMinutes": { "type": "integer", "minimum": 5, "maximum": 60 },
        "validitySeconds": { "type": "integer", "minimum": 300, "maximum": 2592000 },
        "grantedAt": { "$ref": "#/definitions/UTCInstant" },
        "status": { "type": "string", "enum": ["active", "revoked", "expired"] },
        "revokedAt": { "oneOf": [{ "$ref": "#/definitions/UTCInstant" }, { "type": "null" }] }
      }
    },
    "RemoteOverrideRequest": {
      "description": "Request for a reasoned time-bounded release. Approval-required is the MCP default; direct mode is valid only when a separate client policy authorizes the exact devices and time window.",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "targetDeviceIds", "reason", "durationMinutes", "requestedAt", "approvalMode"],
      "properties": {
        "requestId": { "$ref": "#/definitions/CanonicalUUID" },
        "targetDeviceIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/CanonicalUUID" } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "durationMinutes": { "type": "integer", "minimum": 5, "maximum": 60 },
        "requestedAt": { "$ref": "#/definitions/UTCInstant" },
        "approvalMode": { "type": "string", "enum": ["approval_required", "preauthorized_direct"] },
        "oauthClientId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 }
      }
    },
    "RemoteOverride": {
      "description": "Applied release interval. The expiry instant is derived exclusively as startsAt plus durationMinutes, avoiding contradictory clocks.",
      "type": "object",
      "additionalProperties": false,
      "required": ["overrideId", "requestId", "targetDeviceIds", "reason", "durationMinutes", "startsAt", "authorizedBy", "status"],
      "properties": {
        "overrideId": { "$ref": "#/definitions/CanonicalUUID" },
        "requestId": { "$ref": "#/definitions/CanonicalUUID" },
        "targetDeviceIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/CanonicalUUID" } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "durationMinutes": { "type": "integer", "minimum": 5, "maximum": 60 },
        "startsAt": { "$ref": "#/definitions/UTCInstant" },
        "authorizedBy": { "type": "string", "enum": ["fresh_web_aal2", "mcp_user_approval", "mcp_preauthorized_client"] },
        "status": { "type": "string", "enum": ["active", "expired", "cancelled"] }
      }
    },
    "AuditRecord": {
      "description": "Append-only server-readable audit record. The encrypted settings that led to an action are not copied into audit metadata.",
      "type": "object",
      "additionalProperties": false,
      "required": ["auditId", "actorKind", "action", "targetDeviceIds", "reason", "occurredAt"],
      "properties": {
        "auditId": { "$ref": "#/definitions/CanonicalUUID" },
        "actorKind": { "type": "string", "enum": ["user", "device", "oauth_client", "system"] },
        "actorId": { "type": ["string", "null"], "maxLength": 200 },
        "action": { "type": "string", "enum": ["device_enrolled", "device_revoked", "remote_override_requested", "remote_override_approved", "remote_override_denied", "remote_override_cancelled", "remote_override_expired", "entitlement_claimed", "entitlement_revoked"] },
        "targetDeviceIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/CanonicalUUID" } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "occurredAt": { "$ref": "#/definitions/UTCInstant" }
      }
    }
  }
}
