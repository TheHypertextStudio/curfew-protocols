{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hypertext.studio/curfew/device-session.json",
  "title": "DeviceSessionContract",
  "description": "Device enrollment and proof-of-possession session messages.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enrollmentRequest": { "$ref": "#/definitions/DeviceEnrollmentRequest" },
    "enrollmentExchange": { "$ref": "#/definitions/DeviceEnrollmentExchange" },
    "credential": { "$ref": "#/definitions/DeviceCredential" }
  },
  "definitions": {
    "DeviceEnrollmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devicePublicKeyJwk",
        "deviceKeyThumbprint",
        "platform",
        "appVersion",
        "displayName",
        "pkceChallenge",
        "state",
        "coordinatorNonce",
        "deviceProof"
      ],
      "properties": {
        "devicePublicKeyJwk": { "type": "object" },
        "deviceKeyThumbprint": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 40 },
        "appVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "pkceChallenge": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" },
        "state": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "coordinatorNonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "deviceProof": { "$ref": "#/definitions/DeviceProof" }
      }
    },
    "DeviceEnrollmentExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "pkceVerifier", "coordinatorNonce", "deviceProof"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "pkceVerifier": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{43,128}$" },
        "coordinatorNonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "deviceProof": { "$ref": "#/definitions/DeviceProof" }
      }
    },
    "DeviceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jws", "httpMethod", "canonicalUrl", "issuedAt", "jti", "nonce"],
      "properties": {
        "jws": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" },
        "httpMethod": { "type": "string", "pattern": "^[A-Z]+$" },
        "canonicalUrl": { "type": "string", "format": "uri" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "jti": { "type": "string", "format": "uuid" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "accessTokenHash": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$" },
        "bodyDigest": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "DeviceCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "accessToken", "refreshToken", "keyThumbprint", "expiresAt"],
      "properties": {
        "deviceId": { "type": "string", "format": "uuid" },
        "accessToken": { "type": "string", "minLength": 1 },
        "refreshToken": { "type": "string", "minLength": 1 },
        "keyThumbprint": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
