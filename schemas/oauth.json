{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://curfew-protocols.hypertext.studio/schemas/oauth.json",
  "title": "OAuthContract",
  "description": "OAuth resource identifiers and least-privilege scopes for Curfew remote MCP and first-party native account/sync clients. Standard OpenID scopes such as openid and offline_access are requested in addition to the Curfew scopes defined here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource",
    "scopes",
    "firstPartyResource",
    "firstPartyScopes"
  ],
  "properties": {
    "resource": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._~!$&\\x27()*+,;=:@%/-]*)?$",
      "description": "Deployment-selected resource. Consumers must enforce exact equality with their trusted environment configuration."
    },
    "scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/CurfewOAuthScope"
      }
    },
    "firstPartyResource": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._~!$&\\x27()*+,;=:@%/-]*)?$",
      "description": "Deployment-selected resource. Consumers must enforce exact equality with their trusted environment configuration."
    },
    "firstPartyScopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/CurfewFirstPartyOAuthScope"
      }
    }
  },
  "definitions": {
    "CurfewOAuthScope": {
      "type": "string",
      "enum": [
        "curfew:devices:read",
        "curfew:entitlements:read",
        "curfew:wake:read",
        "curfew:lock:device",
        "curfew:lock:all",
        "curfew:unlock:request",
        "curfew:unlock:direct",
        "curfew:unlock:device",
        "curfew:unlock:all"
      ]
    },
    "CurfewFirstPartyOAuthScope": {
      "type": "string",
      "enum": [
        "curfew:account:read",
        "curfew:devices:read",
        "curfew:devices:write",
        "curfew:entitlements:read",
        "curfew:sync:read",
        "curfew:sync:write",
        "curfew:wake:read",
        "curfew:wake:write"
      ]
    }
  }
}
