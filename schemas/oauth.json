{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://curfew-protocols.hypertext.studio/schemas/oauth.json",
  "title": "OAuthContract",
  "description": "OAuth resource identifiers and least-privilege scopes for Curfew remote MCP.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource", "scopes"],
  "properties": {
    "resource": {
      "type": "string",
      "const": "https://curfew-sync.hypertext.studio/mcp"
    },
    "scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/CurfewOAuthScope" }
    }
  },
  "definitions": {
    "CurfewOAuthScope": {
      "type": "string",
      "enum": [
        "curfew:devices:read",
        "curfew:entitlements:read",
        "curfew:wake:read",
        "curfew:unlock:request",
        "curfew:unlock:direct"
      ]
    }
  }
}
