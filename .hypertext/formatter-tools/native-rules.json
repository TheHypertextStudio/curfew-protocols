{
  "setup": [
    ["python3", "{root}/.hypertext/formatter-tools/native.py", "setup-swift"],
    ["python3", "{root}/.hypertext/formatter-tools/extras.py", "setup-csharp"],
    ["python3", "{root}/.hypertext/formatter-tools/kotlin.py", "--setup"]
  ],
  "rules": [
    {
      "name": "SwiftFormat 0.64.0",
      "patterns": ["**/*.swift", "*.swift"],
      "argv": [
        "python3",
        "{root}/.hypertext/formatter-tools/native.py",
        "swift",
        "--path",
        "{path}"
      ]
    },
    {
      "name": "csharp",
      "patterns": ["**/*.cs", "*.cs"],
      "argv": [
        "python3",
        "{root}/.hypertext/formatter-tools/extras.py",
        "csharp"
      ]
    },
    {
      "name": "ktlint1.5.0",
      "patterns": [
        "*.kt",
        "**/*.kt",
        "*.kts",
        "**/*.kts",
        "**/*.kt.template",
        "**/*.kts.template"
      ],
      "argv": [
        "python3",
        "{root}/.hypertext/formatter-tools/kotlin.py",
        "ktlint",
        "{path}"
      ]
    },
    {
      "name": "Swift template",
      "patterns": ["**/*.swift.template"],
      "argv": [
        "python3",
        "{root}/.hypertext/formatter-tools/native.py",
        "swift",
        "--path",
        "{path}"
      ]
    }
  ]
}
